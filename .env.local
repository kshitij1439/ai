# Database
DATABASE_URL=postgresql://user:password@postgres:5432/aimaster?schema=public

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_this_to_a_long_random_string_min_32_chars

# JWT Secret
JWT_SECRET=change_this_to_another_long_random_string

# Google OAuth (for NextAuth)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# AI Provider API Keys

# Google AI (Gemini) - Get at https://ai.google.dev
GOOGLE_AI_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Groq - Get at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Ollama (if running locally)
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI (Optional - Paid)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude (Optional - Paid)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Memory (Mem0)
MEM0_API_KEY=your_mem0_api_key_here

# Pinecone Vector Database (Optional)
# PINECONE_API_KEY=your_pinecone_api_key_here
# PINECONE_INDEX_NAME=your_index_name

# Qdrant Vector Database (for Mem0 backend)
QDRANT_URL=your_qdrant_url_here
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=ai_master_collection